# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to GitHub — it holds secrets.
# Command:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# Random long string Django uses to sign cookies/sessions.
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# True = show detailed errors (local only). False in production.
DEBUG=True

# Comma-separated hosts allowed to serve this app
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL — Docker Compose uses Postgres; leave blank to use SQLite locally
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://toolpool:toolpool@db:5432/toolpool
